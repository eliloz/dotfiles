#!/usr/bin/env bash
set -euo pipefail

# Sandbox size. Explicit so several sandboxes can run at once without each claiming the whole machine.
cpus=4
memory=8g
kit="$HOME/.config/sbx/kits/claude-prefs"

fail() { printf 'box: %s\n' "$*" >&2; exit 1; }
usage() {
  cat <<'HELP'
Usage:
  box <task>         Start Claude in a sandbox for this repo, or reattach to it
  box take <task>    Squash the agent's work into your checkout, uncommitted, for review
  box rm <task>      Delete the sandbox (offers to keep its commits as branch sbx/<task>)
  box ls             List this repo's sandboxes

Each task is a Docker Sandbox (sbx) named <repo>-<task>, running Claude on a
private clone of the repository (your checkout is mounted read-only), with the
claude-prefs kit. The clone starts on the branch you have checked out. Only the
agent's commits come back, through `box take`.

After `box take`: review in Herdr's Changes panel, then `git commit` to accept or
`git reset --hard` to reject. After committing, tell the agent to run
`git pull origin <branch>` before it continues.
HELP
}

[[ $# -gt 0 ]] || { usage; exit 2; }
case "$1" in -h|--help|help) usage; exit 0 ;; esac
command -v git >/dev/null || fail 'git is required'
command -v sbx >/dev/null || fail 'sbx (Docker Sandboxes) is required'
command -v jq >/dev/null || fail 'jq is required'
git rev-parse --show-toplevel >/dev/null 2>&1 || fail 'run inside a Git repository'
# Resolve linked worktrees to the main checkout: sandboxes belong to the repository.
common=$(git rev-parse --path-format=absolute --git-common-dir)
[[ "$common" == */.git ]] || fail 'bare/unusual Git layouts are not supported'
main_root=${common%/.git}
# The checkout you're in (main or a worktree): `box take` squashes into it.
here=$(git rev-parse --show-toplevel)
# sbx names allow letters, numbers, hyphens and periods.
repo=$(basename "$main_root" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9-' '-' | sed 's/^-*//; s/-*$//')
[[ -n "$repo" ]] || fail "can't derive a sandbox name from $main_root"

# Prints running/stopped/..., or nothing when the sandbox does not exist.
status_of() { sbx ls --json | jq -r --arg n "$1" '.[] | select(.name == $n) | .status'; }

op=run
case "$1" in take|rm|ls) op=$1; shift ;; esac

if [[ "$op" == ls ]]; then
  [[ $# -eq 0 ]] || fail 'ls takes no arguments'
  printf '%-24s %s\n' TASK STATUS
  sbx ls --json | jq -r --arg p "$repo-" \
    '.[] | select(.name | startswith($p)) | "\(.name | ltrimstr($p))\t\(.status)"' \
    | while IFS=$'\t' read -r task st; do printf '%-24s %s\n' "$task" "$st"; done
  exit 0
fi

[[ $# -eq 1 ]] || fail "expected one task name (see box --help)"
task=$1
[[ "$task" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || fail 'task must be lowercase letters, numbers and -, starting and ending with a letter or number'
name="$repo-$task"
[[ ${#name} -le 63 ]] || fail "sandbox name $name is longer than 63 characters"
remote="sandbox-$name"
status=$(status_of "$name")

# The sandbox's git remote only answers while it runs; `sbx exec` starts a stopped one.
ensure_running() { [[ "$status" == running ]] || sbx exec "$name" true </dev/null >/dev/null; status=running; }
# The branch the agent is on, asked of the sandbox so nothing has to be recorded.
agent_branch() {
  local b
  b=$(sbx exec "$name" git -C "$main_root" branch --show-current </dev/null | tr -d '\r') || fail "couldn't ask $name for its branch"
  [[ -n "$b" ]] || fail "the agent's clone has a detached HEAD; ask it to switch to a branch"
  printf '%s\n' "$b"
}
fetch_agent() {
  local out
  out=$(git -C "$main_root" fetch --quiet "$remote" 2>&1) || { printf '%s\n' "$out" >&2; fail "fetch from $remote failed"; }
}

if [[ "$op" == run ]]; then
  if [[ -n "$status" ]]; then
    exec sbx run --name "$name"
  fi
  branch=$(git -C "$main_root" symbolic-ref --quiet --short HEAD) || branch='(detached HEAD)'
  [[ -d "$kit" ]] || fail "missing $kit; run: stow --no-folding sbx (from dotfiles)"
  if [[ -n "$(git -C "$main_root" status --porcelain --untracked-files=no)" ]]; then
    printf 'box: uncommitted changes are not copied into the sandbox\n' >&2
  fi
  printf 'Creating sandbox %s on %s (the first run downloads the agent image)...\n' "$name" "$branch"
  exec sbx run --clone --kit "$kit" --cpus "$cpus" --memory "$memory" --name "$name" claude "$main_root"
fi

[[ -n "$status" ]] || fail "no sandbox for task $task; start one with: box $task"

if [[ "$op" == take ]]; then
  # A clean tree is what makes `git reset --hard` a safe way to reject the result.
  [[ -z "$(git -C "$here" status --porcelain --untracked-files=no)" ]] \
    || fail 'you have uncommitted changes; commit or stash them first'
  if [[ -n "$(git -C "$here" ls-files --others --exclude-standard)" ]]; then
    printf 'box: note: untracked files present; `git reset --hard` leaves them, but `git add -A` would include them\n' >&2
  fi
  ensure_running
  branch=$(agent_branch)
  fetch_agent
  tip="refs/remotes/$remote/$branch"
  git -C "$main_root" rev-parse --verify --quiet "$tip^{commit}" >/dev/null || fail "fetched no $branch from $remote"
  if ! git -C "$here" merge --squash --no-stat "$tip"; then
    fail 'the squash stopped with conflicts; resolve them (they show in the Changes panel), then git commit, or git reset --hard to drop it'
  fi
  if git -C "$here" diff --cached --quiet; then
    printf 'Nothing new: the agent'\''s %s matches your checkout.\n' "$branch"
    exit 0
  fi
  git -C "$here" diff --cached --stat
  printf '\nReview in the Changes panel. Accept: git commit. Reject: git reset --hard.\n'
  printf 'After committing, tell the agent to run: git pull origin %s\n' "$(git -C "$here" symbolic-ref --quiet --short HEAD || echo '<branch>')"
  exit 0
fi

if [[ "$op" == rm ]]; then
  printf 'Delete sandbox %s (stops the agent)? [y/N] ' "$name" >&2
  read -r answer || exit 1
  [[ "$answer" == y || "$answer" == Y || "$answer" == yes ]] || { echo 'Cancelled.'; exit 0; }
  keep=
  ensure_running
  branch=$(agent_branch)
  fetch_agent
  tip="refs/remotes/$remote/$branch"
  if git -C "$main_root" rev-parse --verify --quiet "$tip^{commit}" >/dev/null; then
    printf 'Keep the agent'\''s %s as local branch sbx/%s? [y/N] ' "$branch" "$task" >&2
    read -r answer || exit 1
    if [[ "$answer" == y || "$answer" == Y || "$answer" == yes ]]; then
      if existing=$(git -C "$main_root" rev-parse --verify --quiet "refs/heads/sbx/$task"); then
        [[ "$existing" == "$(git -C "$main_root" rev-parse "$tip")" ]] \
          || fail "branch sbx/$task already exists at a different commit; rename or delete it, then retry"
      fi
      keep=$(git -C "$main_root" rev-parse "$tip")
    fi
  fi
  # sbx always warns about unfetched commits; we just fetched, so show its output only on failure.
  out=$(sbx rm --force "$name" 2>&1) || { printf '%s\n' "$out" >&2; fail "sbx rm $name failed"; }
  if [[ -n "$keep" ]]; then git -C "$main_root" branch --force "sbx/$task" "$keep"; fi
  # sbx removes its remote, but leaves the refs/sandboxes/<name>/* copies it made of the clone's branches.
  while IFS= read -r ref; do git -C "$main_root" update-ref -d "$ref"; done \
    < <(git -C "$main_root" for-each-ref --format='%(refname)' "refs/sandboxes/$name/")
  if git -C "$main_root" remote get-url "$remote" >/dev/null 2>&1; then git -C "$main_root" remote remove "$remote"; fi
  if [[ -n "$keep" ]]; then printf 'Removed %s. Kept its commits on branch sbx/%s.\n' "$name" "$task"
  else printf 'Removed %s.\n' "$name"; fi
  exit 0
fi
