# Shared list: what both machines need. `brew bundle` uses this one by default
# (HOMEBREW_BUNDLE_FILE in .zprofile). Each machine also has its own list:
# Brewfile.personal, or Brewfile.local (not tracked) where the list stays private.

# Docker's tap (for sbx)
tap "docker/tap"

# Simple, fast and user-friendly alternative to find
brew "fd"
# Command-line fuzzy finder written in Go
brew "fzf"
# GitHub command-line tool
brew "gh"
# Like cURL, but for gRPC
brew "grpcurl"
# Kubernetes package manager
brew "helm"
# Lightweight and flexible command-line JSON processor
brew "jq"
# Kubernetes CLI To Manage Your Clusters In Style!
brew "k9s"
# Kubernetes command-line interface
brew "kubernetes-cli"
# Polyglot runtime manager (asdf rust clone)
brew "mise"
# Ambitious Vim-fork focused on extensibility and agility
brew "neovim"
# Theme for zsh
brew "powerlevel10k"
# Search tool like grep and The Silver Searcher
brew "ripgrep"
# Static analysis and lint tool, for (ba)sh scripts
brew "shellcheck"
# Organize software neatly under a single directory tree (e.g. /usr/local)
brew "stow"
# Define your dev environment as code. For microservice apps on Kubernetes
brew "tilt"
# Terminal multiplexer
brew "tmux"
# Parser generator tool (nvim-treesitter uses it to build parsers)
brew "tree-sitter-cli"
# Fish-like fast/unobtrusive autosuggestions for zsh
brew "zsh-autosuggestions"
# Fish shell like syntax highlighting for zsh
brew "zsh-syntax-highlighting"

# Password manager
cask "1password"
# 1Password command-line tool
cask "1password-cli"
# App to build and share containerised applications and microservices
cask "docker-desktop"
cask "font-meslo-lg-nerd-font"
# Terminal emulator that uses platform-native UI and GPU acceleration
cask "ghostty"
# Desktop app for coding agents (installs herdr-core / hc on first launch)
cask "herdr-app"
# Docker Sandboxes (agent sandboxes; the box script drives it)
cask "docker/tap/sbx"
