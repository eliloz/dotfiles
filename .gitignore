# macOS
.DS_Store

# Secrets / machine-local overrides — never commit
*.local
!/scripts/.local/
.env
.env.*
*.pem
*.key
id_*
.netrc

# Editor/runtime state
*.swp
*~
.zsh_history
.zcompdump*

# Runtime state that tools write next to stowed config.
# No blanket *.lock: nvim-pack-lock.json is tracked on purpose.
credentials.yaml
*.log
*.sock*
session-snapshots/
.plugins.lock
